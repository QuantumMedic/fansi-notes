---
import PlatformButton from './PlatformButton.astro';
import { platformsSchema } from '../lib/model.mjs';
interface Props {
  links: unknown;
}
const links = platformsSchema.parse(Astro.props.links);
const entries = [
  ['instagram_url', 'instagram'],
  ['vocus_url', 'vocus'],
] as const;
---

{entries.some(([key]) => links[key]) && (
  <nav class="platform-links" aria-label="其他平台">
    {entries.map(
      ([key, label]) =>
        links[key] && (
          <PlatformButton platform={label} href={links[key]} />
        ),
    )}
  </nav>
)}

<style>.platform-links{display:flex;flex-wrap:wrap;gap:12px}</style>
