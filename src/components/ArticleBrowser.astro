---
import WorkCard from './WorkCard.astro';
import { catalog } from '../lib/catalog';
import { topics, series } from '../data/site';
import { matchesSeries } from '../lib/taxonomy.mjs';
interface Props {
  title?: string;
  fixedSeries?: string;
}
const { title = '探索文章', fixedSeries = '' } = Astro.props;
const articles = (await catalog()).articles.filter((a) =>
  matchesSeries(a.data.content_type, fixedSeries),
);
---

<div data-article-browser data-fixed-series={fixedSeries}>
  <section class="page-heading">
    <p class="eyebrow">文字的入口</p>
    <h1>{title}</h1>
    <p>在這裡，找一個想繼續想下去的問題。</p>
    <p class="muted">可搜尋標題與完整正文，或依主題尋找文章。</p>
  </section>
  <section class="section" id="search">
    <form class="filters" role="search">
      <label>
        搜尋標題、摘要或正文
        <input type="search" name="q" id="query" placeholder="輸入關鍵字" />
      </label>
      {!fixedSeries && (
        <label>
          作品系列
          <select id="type" name="type">
            <option value="">全部文章</option>
            {series.map((s) => (
              <option value={s.slug}>{s.name}</option>
            ))}
          </select>
        </label>
      )}
      <label>
        主題
        <select id="topic">
          <option value="">全部主題</option>
          {topics.map((t) => (
            <option value={t.slug}>{t.name}</option>
          ))}
        </select>
      </label>
      <label>
        排序
        <select id="sort">
          <option value="newest">最新優先</option>
          <option value="oldest">最早優先</option>
        </select>
      </label>
      <button type="reset">清除篩選</button>
    </form>
    <p id="results" role="status">
      共 {articles.length} 篇文章
    </p>
    <div class="cards" id="article-results">
      {articles.map((a) => (
        <div
          data-work-id={a.data.work_id}
          data-result
          data-date={a.data.published_at}
          data-type={a.data.content_type}
          data-topics={a.data.topics.join(' ')}
          data-search={`${a.data.title} ${a.data.summary} ${a.body || ''} ${a.data.keywords.join(' ')}`}
        >
          <WorkCard id={a.data.slug} {...a.data} type={a.data.content_type} />
        </div>
      ))}
    </div>
    <p id="no-results" hidden>
      沒有符合的文章，請清除篩選再試一次。
    </p>
  </section>
</div>
<script>
  import { publicSeriesSlug } from '../lib/taxonomy.mjs';
  import { prepareSearch, matchesPrepared } from '../lib/search.mjs';
  const form = document.querySelector<HTMLFormElement>('#search form')!;
  const query = document.querySelector<HTMLInputElement>('#query')!;
  const type = document.querySelector<HTMLSelectElement>('#type');
  const fixedSeries =
    (document.querySelector('[data-article-browser]') as HTMLElement).dataset.fixedSeries || '';
  const topic = document.querySelector<HTMLSelectElement>('#topic')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const list = document.querySelector('#article-results')!;
  const rows = [...list.querySelectorAll<HTMLElement>('[data-result]')].map((el) => ({
    el,
    date: Date.parse(el.dataset.date!),
    record: prepareSearch(el.dataset.search!, el.dataset.topics!.split(' '), el.dataset.type!),
  }));
  const params = new URLSearchParams(location.search);
  for (const [select, key] of [
    [type, 'type'],
    [topic, 'topic'],
    [sort, 'sort'],
  ] as const) {
    const raw = params.get(key);
    const value = key === 'type' && raw ? publicSeriesSlug(raw) : raw;
    if (select && value && [...select.options].some((o) => o.value === value)) select.value = value;
  }
  query.value = params.get('q') || '';
  let lastSort = '',
    timer: ReturnType<typeof setTimeout>,
    composing = false;
  function filter() {
    clearTimeout(timer);
    if (sort.value !== lastSort) {
      rows.sort((a, b) => (b.date - a.date) * (sort.value === 'oldest' ? -1 : 1));
      list.append(...rows.map((r) => r.el));
      lastSort = sort.value;
    }
    let count = 0;
    for (const row of rows) {
      row.el.hidden = !matchesPrepared(row.record, {
        q: query.value,
        topic: topic.value,
        contentType: fixedSeries || type?.value || '',
      });
      if (!row.el.hidden) count++;
    }
    document.querySelector('#results')!.textContent = `共 ${count} 篇文章`;
    document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
  }
  query.addEventListener('compositionstart', () => {
    composing = true;
    clearTimeout(timer);
  });
  query.addEventListener('compositionend', () => {
    composing = false;
    filter();
  });
  query.addEventListener('input', () => {
    clearTimeout(timer);
    if (!composing) timer = setTimeout(filter, 120);
  });
  form.addEventListener('change', filter);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    filter();
  });
  form.addEventListener('reset', () => {
    clearTimeout(timer);
    setTimeout(filter);
  });
  filter();
</script>
