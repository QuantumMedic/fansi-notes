---
import type { Publication } from '../lib/publications.ts';
interface Props {
  book: Publication;
}
const { book: b } = Astro.props;
---

<div class="publication-cover" style={`--book-tone:var(--${b.theme})`}>
  {b.cover ? (
    <img src={b.cover} alt={`${b.title}書封`} loading="lazy" />
  ) : (
    <div class="placeholder">
      <span>示意書封</span>
      <div class="ornament" aria-hidden="true"></div>
      <strong>{b.title}</strong>
      <small>{b.synthetic ? '合成測試・非作者作品' : '正式書封待提供'}</small>
    </div>
  )}
</div>
<style>
  .publication-cover {
    width: 100%;
    aspect-ratio: 2/3;
    position: relative;
    box-shadow: 5px 7px 13px #373a391c;
    border-radius: 1px 3px 3px 1px;
    background: var(--book-tone);
    overflow: hidden;
  }
  .publication-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow:
      inset 5px 0 8px #0002,
      inset -3px 0 0 #ffffff42;
    border: 1px solid #373a3920;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--paper);
  }
  .placeholder {
    height: 100%;
    padding: 12% 11% 9% 15%;
    display: flex;
    flex-direction: column;
    position: relative;
    background: linear-gradient(120deg, #fff3, transparent 60%);
    color: #202a25;
  }
  .placeholder span,
  .placeholder small {
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .placeholder strong {
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.6;
    position: relative;
    margin: auto 0;
  }
  .placeholder small {
    letter-spacing: 0;
    line-height: 1.6;
  }
  .ornament {
    width: 45%;
    aspect-ratio: 1;
    border: 1px solid #ffffff80;
    border-radius: 50% 50% 0 0;
    position: absolute;
    right: 12%;
    top: 17%;
    opacity: 0.6;
  }
</style>
