---
import illustration from '../assets/storybook.svg?raw';
import {url} from '../data/site';
const scenes=[
 {id:'garden',number:'01',name:'凡思維',world:'思想的花園',description:'從一個問題，長出新的思考。',preview:'測試預覽：紙上花園',href:'series/fansiwei/'},
 {id:'sound',number:'02',name:'凡思聲',world:'聲音的房間',description:'留一段時間，讓聲音陪你。',preview:'節目與單集資料待提供',href:'podcast/'},
 {id:'corridor',number:'03',name:'深度文章',world:'故事的長廊',description:'沿著文字，往深處走一點。',preview:'測試預覽：閱讀之窗',href:'articles/?type=longform'},
 {id:'kingdom',number:'04',name:'小說與出版',world:'想像的國度',description:'推開門，遇見另一個世界。',preview:'正式書封與作品資料待提供',href:'works/'},
 {id:'desk',number:'05',name:'關於作者',world:'作者的書桌',description:'認識書頁背後的創作。',preview:'公開署名與簡介待確認',href:'about/'},
];
---
<section class="storybook" aria-labelledby="story-title" data-motion="on">
 <div class="story-intro"><p class="eyebrow">凡思筆記 × 作者個人品牌</p><h1 id="story-title">每一頁，<br class="mobile-break"/>都是一個入口。</h1><p>在文字、聲音與想像之間，慢慢展開你的好奇。</p></div>
 <div class="book-stage"><div class="illustration" aria-hidden="true" set:html={illustration}/>
 <nav class="scene-links" aria-label="五大創作場景">{scenes.map(s=><a class="scene-link" data-target={s.id} href={url(s.href)} aria-describedby={`preview-${s.id}`}><span class="scene-number">{s.number} / {s.world}</span><strong>{s.name}<span aria-hidden="true">↗</span></strong><span class="scene-description">{s.description}</span><span class="scene-preview" id={`preview-${s.id}`}>{s.preview}</span></a>)}</nav></div>
 <div class="book-caption"><span>分層插畫示意 · 尚未定版</span><a href="#latest">往下閱讀 ↓</a><button class="motion-toggle" type="button" aria-pressed="false" hidden>減少動態</button></div>
</section>
<script>
const root=document.querySelector<HTMLElement>('.storybook')!;
const toggle=root.querySelector<HTMLButtonElement>('.motion-toggle')!;
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
const fine=matchMedia('(hover: hover) and (pointer: fine)');
let manual=false, frame=0, x=0,y=0;
const reset=()=>{cancelAnimationFrame(frame);frame=0;root.style.setProperty('--px','0px');root.style.setProperty('--py','0px')};
const sync=()=>{const off=reduced.matches||manual;root.dataset.motion=off?'off':'on';toggle.setAttribute('aria-pressed',String(off));toggle.textContent=reduced.matches?'已遵循裝置：減少動態':off?'動態已減少':'減少動態';toggle.disabled=reduced.matches;reset()};
toggle.hidden=false;toggle.addEventListener('click',()=>{manual=!manual;sync()});reduced.addEventListener('change',sync);fine.addEventListener('change',reset);sync();
root.addEventListener('pointermove',e=>{if(root.dataset.motion==='off'||!fine.matches||e.pointerType==='touch')return;const r=root.getBoundingClientRect();x=((e.clientX-r.left)/r.width-.5)*8;y=((e.clientY-r.top)/r.height-.5)*5;if(!frame)frame=requestAnimationFrame(()=>{root.style.setProperty('--px',`${x}px`);root.style.setProperty('--py',`${y}px`);frame=0})});
root.addEventListener('pointerleave',reset);
</script>
<style is:global>
.storybook{--px:0px;--py:0px;max-width:1440px;margin:auto;padding:38px 32px 0}.story-intro{text-align:center}.story-intro h1{font-size:clamp(2.5rem,4.2vw,4rem);margin:16px 0;letter-spacing:.12em}.story-intro>p:last-child{color:var(--muted);font-size:14px;letter-spacing:.08em}.mobile-break{display:none}.book-stage{position:relative;max-width:1200px;margin:-42px auto 0}.illustration svg{display:block;width:100%;height:auto;overflow:visible}.illustration [data-layer]{transition:transform .35s ease-out;transform-box:fill-box;transform-origin:center}.illustration [data-layer=distance]{transform:translate(calc(var(--px) * -.5),calc(var(--py) * -.5))}.illustration [data-layer=book]{transform:translate(calc(var(--px) * .25),calc(var(--py) * .25))}.illustration [data-layer=scene]{transform:translate(var(--px),var(--py));filter:drop-shadow(2px 5px 2px #72664718)}.illustration [data-layer=foreground]{transform:translate(calc(var(--px) * 1.6),calc(var(--py) * 1.6))}.scene-links{position:relative;margin:-35px 10% 0;display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.scene-link{position:relative;display:flex;flex-direction:column;padding:10px 8px 16px;min-height:112px;border-top:1px solid #aa9a79;isolation:isolate}.scene-link::before{content:'';position:absolute;inset:-380px 0 0;z-index:-1}.scene-link strong{display:flex;justify-content:space-between;gap:4px;font:19px/1.7 var(--serif);white-space:nowrap}.scene-link strong span{font:14px/2 var(--sans)}.scene-number{font-size:10px;color:#655e4e;letter-spacing:.03em;white-space:nowrap}.scene-description{font-size:11px;line-height:1.8;color:#5d6359;margin-top:4px}.scene-preview{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);width:190px;background:#f9f5ec;border:1px solid #aa9a79;padding:12px;font-size:12px;text-align:center;opacity:0;pointer-events:none;box-shadow:0 5px 15px #4f4c3310}.scene-link:hover,.scene-link:focus-visible{text-decoration:none;background:#f8f3e6c9}.scene-link:hover .scene-preview,.scene-link:focus-visible .scene-preview{opacity:1}.book-caption{max-width:1030px;margin:20px auto 0;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:11px;color:var(--muted)}.motion-toggle{border:0;border-bottom:1px solid #a5987d;font-size:11px;padding:6px;margin:0}.motion-toggle:disabled{cursor:default}.leaf,.turn-page,.lamp-glow,.door-glow,.desk-light{transform-box:fill-box;transform-origin:bottom;transition:transform .3s,filter .3s,opacity .3s}.book-stage:has([data-target=garden]:is(:hover,:focus-visible)) .leaf{transform:rotate(-5deg)}.book-stage:has([data-target=sound]:is(:hover,:focus-visible)) .lamp-glow{filter:brightness(1.25)}.book-stage:has([data-target=corridor]:is(:hover,:focus-visible)) .turn-page{transform:rotate(-5deg) translateY(-3px)}.book-stage:has([data-target=kingdom]:is(:hover,:focus-visible)) .door-glow{filter:brightness(1.2)}.book-stage:has([data-target=desk]:is(:hover,:focus-visible)) .desk-light{filter:brightness(1.25)}.storybook[data-motion=off] .illustration *{transform:none!important;transition:none!important;filter:none!important}
@media(max-width:1000px){.storybook{padding:36px 16px 0}.scene-links{margin:-25px 4% 0;gap:8px}.scene-link::before{inset:-235px 0 0}.scene-number{font-size:9px}.scene-description{font-size:10px}.scene-link strong{font-size:17px}.book-caption{margin:20px 20px 0}}
@media(max-width:760px){.storybook{padding:30px 20px 0}.story-intro h1{font-size:2.45rem;margin:16px 0;line-height:1.5}.mobile-break{display:block}.story-intro>p:last-child{font-size:13px;max-width:270px;margin:0 auto}.book-stage{margin:-10px -15px 0}.illustration svg{width:100%}.scene-links{position:static;margin:-15px 15px 0;grid-template-columns:1fr;gap:0}.scene-link{padding:15px 0;min-height:90px;display:grid;grid-template-columns:1fr auto;column-gap:10px;border-top:1px solid var(--line)}.scene-link::before{display:none}.scene-number{grid-column:1;font-size:10px}.scene-link strong{grid-column:1;font-size:21px;display:block}.scene-link strong span{margin-left:15px}.scene-description{grid-column:2;grid-row:1/3;align-self:center;font-size:11px;max-width:130px}.scene-preview{position:static;grid-column:1/3;transform:none;width:auto;padding:0;background:none;border:0;box-shadow:none;text-align:left;font-size:10px;color:var(--muted);opacity:1}.book-caption{margin:12px 0 0;flex-wrap:wrap;gap:10px}.book-caption>a{display:none}.illustration [data-layer]{transform:none!important}.scene-link:hover,.scene-link:focus-visible{background:transparent}}
@media(prefers-reduced-motion:reduce){.storybook .illustration *{transform:none!important;filter:none!important;transition:none!important}}
</style>
