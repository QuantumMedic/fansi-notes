---
import { seriesName, publicSeriesSlug, topicName, statusName } from '../lib/taxonomy.mjs';
import { url } from '../data/site';
const { classification: c } = Astro.props;
---

{c && (
  <div class="classification">
    {c.content_type && <a href={url(`series/${publicSeriesSlug(c.content_type)}/`)}>{seriesName(c.content_type)}</a>}
    {c.topics.map((id: string, i: number) => (
      <a href={url(`topics/${id}/`)}>
        {i === 0 ? '主要' : '次要'}：{topicName(id)}
      </a>
    ))}
    <span>{statusName(c.status)}</span>
  </div>
)}
<style>
  .classification {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 12px;
    color: var(--muted);
    margin: 12px 0;
  }
  .classification a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
