---
import ClassificationBadge from './ClassificationBadge.astro';
import { url } from '../data/site';
import { displayDate } from '../lib/catalog';
interface Props {
  episode: {
    slug: string;
    title: string;
    description: string;
    published_at: string;
    synthetic: boolean;
    cover_image?: string;
    classification?: any;
  };
}
const { episode: e } = Astro.props;
---

<article class="episode-card">
  <a href={url(`podcast/${e.slug}/`)}>
    {e.cover_image ? (
      <img
        src={e.cover_image}
        alt={`${e.title} 單集封面`}
        width="160"
        height="160"
        loading="lazy"
        referrerpolicy="no-referrer"
      />
    ) : (
      <div class="episode-placeholder" aria-hidden="true">
        凡思聲
      </div>
    )}
    <div>
      <p class="eyebrow">
        {e.synthetic ? '示意單集' : '凡思聲'} ·{' '}
        <time datetime={e.published_at}>{displayDate(e.published_at)}</time>
      </p>
      <h3>{e.title}</h3>
      <p class="episode-summary">{e.description}</p>
    </div>
  </a>
  <ClassificationBadge classification={e.classification} />
</article>
<style>
  .episode-card {
    border-top: 1px solid var(--line);
    padding: 26px 0;
  }
  .episode-card > a {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 25px;
  }
  .episode-card img {
    width: 140px;
    height: 140px;
    object-fit: cover;
  }
  .episode-summary {
    font-size: 14px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .episode-placeholder {
    aspect-ratio: 1;
    background: var(--sage);
    display: grid;
    place-items: center;
    font: 24px var(--serif);
  }
  @media (max-width: 600px) {
    .episode-card > a {
      grid-template-columns: 80px 1fr;
      gap: 15px;
    }
    .episode-card img {
      width: 80px;
      height: 80px;
    }
    .episode-card h3 {
      font-size: 1.2rem;
    }
    .episode-card .eyebrow {
      font-size: 10px;
      letter-spacing: 0;
    }
  }
</style>
