---
import { seriesName } from '../lib/taxonomy.mjs';
import { url } from '../data/site';
interface Props {
  id: string;
  title: string;
  summary: string;
  type?: string;
  published_at?: string;
  synthetic?: boolean;
  cover_image?: string;
  cover_alt?: string;
}
const { id, title, summary, type, published_at, synthetic = true, cover_image, cover_alt } = Astro.props;
---

<article class="work-card">
  <a href={url(`articles/${id}/`)}>
    {cover_image && <img class="article-banner" src={url(cover_image)} alt={cover_alt || ''} loading="lazy" decoding="async" />}
    {!cover_image && synthetic && <div class:list={['cover', type]} aria-hidden="true">
      <span class="cover-orbit"></span>
      <span class="cover-window"></span>
      <small>示意插畫</small>
    </div>}
    <p class="eyebrow">
      {seriesName(type)} · {synthetic ? '測試資料' : '公開文章'}
    </p>
    <p class="muted">{published_at?.slice(0, 10)}</p>
    <h3>
      {title}
      <span>↗</span>
    </h3>
    <p>{summary}</p>
  </a>
</article>

<style>
  .article-banner {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 1rem;
  }
</style>
