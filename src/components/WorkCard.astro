---
import { seriesName } from '../lib/taxonomy.mjs';
import { url } from '../data/site';
interface Props {
  id: string;
  title: string;
  summary: string;
  type?: string;
  published_at?: string;
  synthetic?: boolean;
}
const { id, title, summary, type, published_at, synthetic = true } = Astro.props;
---

<article class="work-card">
  <a href={url(`articles/${id}/`)}>
    {synthetic && <div class:list={['cover', type]} aria-hidden="true">
      <span class="cover-orbit"></span>
      <span class="cover-window"></span>
      <small>示意插畫</small>
    </div>}
    <p class="eyebrow">
      {seriesName(type)} · {synthetic ? '測試資料' : '公開文章'}
    </p>
    <p class="muted">{published_at?.slice(0, 10)}</p>
    <h3>
      {title}
      <span>↗</span>
    </h3>
    <p>{summary}</p>
  </a>
</article>
