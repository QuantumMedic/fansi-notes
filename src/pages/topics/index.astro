---
import Main from '../../layouts/Main.astro';
import { topics, url } from '../../data/site';
---

<Main title="探索主題">
  <section class="page-heading">
    <p class="eyebrow">主題索引 · 測試資料</p>
    <h1>沿著好奇，繼續閱讀。</h1>
    <div class="topic-links">
      {topics.map((t) => (
        <a href={url(`topics/${t.slug}/`)}>{t.name} ↗</a>
      ))}
    </div>
  </section>
</Main>
