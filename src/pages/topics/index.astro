---
import Main from '../../layouts/Main.astro';
import { topics, url } from '../../data/site';
---

<Main title="探索主題">
  <section class="page-heading">
    <p class="eyebrow">九大主題</p>
    <h1>沿著好奇，閱讀與聆聽。</h1>
    <div class="topic-links">
      {topics.map((t) => (
        <a href={url(`topics/${t.slug}/`)}>{t.name} ↗</a>
      ))}
    </div>
  </section>
</Main>
