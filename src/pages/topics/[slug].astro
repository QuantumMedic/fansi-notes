---
import Main from '../../layouts/Main.astro';
import WorkExplorer from '../../components/WorkExplorer.astro';
import { topics, topicAliases } from '../../lib/taxonomy.mjs';
import { catalog } from '../../lib/catalog';
export function getStaticPaths() {
  return [
    ...topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic, redirect: '' } })),
    ...Object.entries(topicAliases).map(([alias, canonical]) => ({
      params: { slug: alias }, props: { topic: topics.find(t => t.slug === canonical)!, redirect: canonical },
    })),
  ];
}
const { topic, redirect } = Astro.props;
if (redirect) return Astro.redirect(`${import.meta.env.BASE_URL}topics/${redirect}/`, 301);
const { works } = await catalog();
---

<Main title={topic.name}>
  <section class="page-heading">
    <p class="eyebrow">主題分類</p>
    <h1>{topic.name}</h1>
    <p>沿著同一個主題，探索文字與聲音。</p>
  </section>
  <WorkExplorer works={works} initialTopic={topic.slug} />
</Main>
