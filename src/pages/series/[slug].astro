---
import {url} from '../../data/site';
import Main from '../../layouts/Main.astro';
import ArticleBrowser from '../../components/ArticleBrowser.astro';
import { publicSeries, series, publicSeriesSlug } from '../../lib/taxonomy.mjs';
export function getStaticPaths() {
  return [...publicSeries, ...series.filter(s => publicSeriesSlug(s.slug) !== s.slug)].map((s) => ({ params: { slug: s.slug }, props: { series: s } }));
}
const { series: s } = Astro.props;
if (publicSeriesSlug(s.slug) !== s.slug) return Astro.redirect(url(`series/${publicSeriesSlug(s.slug)}/`), 301);
---

<Main title={s.name}>
  <ArticleBrowser title={s.name} fixedSeries={s.slug} />
</Main>
