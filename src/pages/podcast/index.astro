---
import { reviewMode } from '../../lib/review-mode.mjs';
import Main from '../../layouts/Main.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { catalog } from '../../lib/catalog';
import { topics, series, url } from '../../data/site';
import config from '../../data/podcast-config.json';
const { episodes } = await catalog();
---

<Main title="凡思聲" description="凡思聲 Podcast 單集列表與收聽入口。">
  <section class="page-heading">
    <p class="eyebrow">聲音的房間</p>
    <h1>凡思聲</h1>
    {reviewMode && <a href={url('review/classifications/')}>檢視分類建議 ↗</a>}
    <p class="muted">單集資料來自作者提供的公開 RSS；節目介紹待作者核准。</p>
    {config.show_url && (
      <a class="button" href={config.show_url} target="_blank" rel="noopener noreferrer">
        在 Spotify 收聽節目 ↗
      </a>
    )}
    {config.apple_show_url && (
      <p>
        <a class="button" href={config.apple_show_url} target="_blank" rel="noopener noreferrer">
          在 Apple Podcasts 開啟《凡思聲》 ↗
        </a>
      </p>
    )}
  </section>
  <section class="section">
    <form class="filters" role="search">
      <label>
        搜尋單集
        <input id="episode-search" type="search" name="q" placeholder="單集標題或介紹" />
      </label>
      <label>
        主題分類
        <select id="episode-topic">
          <option value="">全部單集</option>
          {topics.map((t) => (
            <option value={t.slug}>{t.name}</option>
          ))}
        </select>
      </label>
      <label for="episode-series">
        作品系列
        <select id="episode-series">
          <option value="">全部系列</option>
          {series.map((s) => (
            <option value={s.slug}>{s.name}</option>
          ))}
        </select>
      </label>
      <button type="reset">清除篩選</button>
    </form>
    <p class="muted">
      {reviewMode ? '本機審閱包含待審核分類建議。' : '僅使用已確認的作品分類。'}未分類單集仍列在全部
      Podcast，標示「分類待確認」。
    </p>
    <p id="episode-count" role="status">
      共 {episodes.length} 集
    </p>
    <div>
      {episodes.map((e) => {
        return (
          <div
            data-episode
            data-search={`${e.title} ${e.description} ${e.classification.keywords.join(' ')}`}
            data-series={e.classification.content_type}
            data-topics={e.classification.topics.join(' ')}
          >
            <EpisodeCard episode={e} />
          </div>
        );
      })}
    </div>
    <p id="episode-empty" hidden>
      沒有符合的單集，請清除篩選。
    </p>
  </section>
</Main>
<script>
  const form = document.querySelector('form')!;
  const input = document.querySelector<HTMLInputElement>('#episode-search')!;
  const topic = document.querySelector<HTMLSelectElement>('#episode-topic')!;
  const series = document.querySelector<HTMLSelectElement>('#episode-series')!;
  function filter() {
    let n = 0;
    document.querySelectorAll<HTMLElement>('[data-episode]').forEach((el) => {
      el.hidden = !(
        input.value
          .trim()
          .toLowerCase()
          .split(/\s+/)
          .every((t) => el.dataset.search!.toLowerCase().includes(t)) &&
        (!topic.value || el.dataset.topics!.split(' ').includes(topic.value)) &&
        (!series.value || el.dataset.series === series.value)
      );
      if (!el.hidden) n++;
    });
    document.querySelector('#episode-count')!.textContent = `共 ${n} 集`;
    document.querySelector<HTMLElement>('#episode-empty')!.hidden = n > 0;
  }
  form.addEventListener('input', filter);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    filter();
  });
  form.addEventListener('reset', () => setTimeout(filter));
</script>
