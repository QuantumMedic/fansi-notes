---
import { popularityRank } from '../../lib/popularity.mjs';
import { reviewMode } from '../../lib/review-mode.mjs';
import Main from '../../layouts/Main.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import Pagination from '../../components/Pagination.astro';
import { catalog } from '../../lib/catalog';
import { topics, series, url } from '../../data/site';
import config from '../../data/podcast-config.json';
const { episodes } = await catalog();
const unconfirmedCount = episodes.filter(e => e.classification.status !== 'confirmed').length;
---

<Main title="凡思聲" description="凡思聲 Podcast 單集列表與收聽入口。">
  <section class="page-heading">
    <p class="eyebrow">聲音的房間</p>
    <h1>凡思聲</h1>
    {reviewMode && <a href={url('review/classifications/')}>檢視分類建議 ↗</a>}
    <p class="muted">單集資料來自作者提供的公開 RSS；節目介紹待作者核准。</p>
    {config.show_url && (
      <a class="button" href={config.show_url} target="_blank" rel="noopener noreferrer">
        在 Spotify 收聽節目 ↗
      </a>
    )}
    {config.apple_show_url && (
      <p>
        <a class="button" href={config.apple_show_url} target="_blank" rel="noopener noreferrer">
          在 Apple Podcasts 開啟《凡思聲》 ↗
        </a>
      </p>
    )}
  </section>
  <section class="section">
    <form class="filters" role="search">
      <label>
        搜尋單集
        <input id="episode-search" type="search" name="q" placeholder="單集標題或介紹" />
      </label>
      <label>
        主題分類
        <select id="episode-topic">
          <option value="">全部單集</option>
          {topics.map((t) => (
            <option value={t.slug}>{t.name}</option>
          ))}
        </select>
      </label>
      <label for="episode-series">
        作品系列
        <select id="episode-series">
          <option value="">全部系列</option>
          {series.map((s) => (
            <option value={s.slug}>{s.name}</option>
          ))}
        </select>
      </label>
      <label>排序<select id="episode-sort"><option value="newest">最新</option><option value="oldest">最早</option><option value="popular">熱門</option></select></label>
      <button type="reset">清除篩選</button>
    </form>
    <p class="muted">
      {reviewMode ? '本機審閱可檢視分類候選。' : '系列與主題依已確認的作品分類呈現。'}
      {unconfirmedCount > 0
        ? `仍有 ${unconfirmedCount} 集待確認分類；單集保留在全部 Podcast，不虛構主題。`
        : `目前 ${episodes.length} 集均已完成系列與主題分類。`}
    </p>
    <p class="muted">熱門依發布後首7天播放與下載總數的核准順位（非即時）；精確快照日期未提供。未知順位列於最後。</p>
    <p id="episode-count" role="status">
      共 {episodes.length} 集
    </p>
    <div id="episode-results">
      {episodes.map((e) => {
        return (
          <div
            data-episode
            data-id={e.guid}
            data-date={e.published_at}
            data-rank={popularityRank('podcast',e.guid) ?? ''}
            data-search={`${e.title} ${e.description} ${e.classification.keywords.join(' ')}`}
            data-series={e.classification.content_type}
            data-topics={e.classification.topics.join(' ')}
          >
            <EpisodeCard episode={e} />
          </div>
        );
      })}
    </div>
    <Pagination />
    <p id="episode-empty" hidden>
      沒有符合的單集，請清除篩選。
    </p>
  </section>
</Main>
<script>
  import {listPagination} from '../../lib/list-pagination';
  import {compareBrowse} from '../../lib/browse-sort.mjs';
  import {matchesSeries} from "../../lib/taxonomy.mjs";
  const form = document.querySelector('form')!;
  const input = document.querySelector<HTMLInputElement>('#episode-search')!;
  const topic = document.querySelector<HTMLSelectElement>('#episode-topic')!;
  const series = document.querySelector<HTMLSelectElement>('#episode-series')!;
  const sort=document.querySelector<HTMLSelectElement>('#episode-sort')!;
  const rows=[...document.querySelectorAll<HTMLElement>('[data-episode]')].map(el=>({el,id:el.dataset.id!,date:Date.parse(el.dataset.date!),rank:el.dataset.rank?Number(el.dataset.rank):null}));
  const pager=listPagination(document.querySelector<HTMLElement>('[data-pagination]')!,document.querySelector<HTMLElement>('#episode-results')!,document.querySelector<HTMLElement>('#episode-count')!,15);
  function filter() {
    rows.sort((a,b)=>compareBrowse(a,b,sort.value));
    if(rows.length)rows[0].el.parentElement!.append(...rows.map(r=>r.el));
    let n = 0;
    document.querySelectorAll<HTMLElement>('[data-episode]').forEach((el) => {
      el.hidden = !(
        input.value
          .trim()
          .toLowerCase()
          .split(/\s+/)
          .every((t) => el.dataset.search!.toLowerCase().includes(t)) &&
        (!topic.value || el.dataset.topics!.split(' ').includes(topic.value)) &&
        matchesSeries(el.dataset.series || "", series.value)
      );
      if (!el.hidden) n++;
    });
    document.querySelector('#episode-count')!.textContent = `共 ${n} 集`;
    document.querySelector<HTMLElement>('#episode-empty')!.hidden = n > 0;
    pager.update();
  }
  form.addEventListener('input', filter);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    filter();
  });
  form.addEventListener('reset', () => setTimeout(filter));
  filter();
</script>
