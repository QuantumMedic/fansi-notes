---
import Main from '../layouts/Main.astro';
import {author} from '../lib/author';
import {site,url} from '../data/site';
import Bookshelf from '../components/Bookshelf.astro';
const photo=author.photo && (author.photo.startsWith('https://')?author.photo:url(author.photo));
---
<Main title="關於作者">
<section class="page-heading author-opening">
  {author.approved && photo && <img src={photo} alt={author.photo_alt || '作者核准照片'} width="640" height="960" />}
  <div><p class="eyebrow">作者的書桌</p><h1>{author.approved&&author.name?author.name:'關於作者'}</h1>
  {author.approved && author.label && <p class="author-label">{author.label}</p>}
  <p>{author.approved&&author.bio?author.bio:'公開署名與作者簡介整理中。先從文字、聲音與故事，認識這裡的創作。'}</p></div>
</section>
<section class="section author-journey">
{author.approved && author.timeline.length>0 && <><h2>創作歷程</h2><ol>{author.timeline.map(x=><li><strong>{x.year}</strong> {x.event}{x.source_url && <a href={x.source_url} aria-label={`${x.year}年創作歷程來源`}> ↗</a>}</li>)}</ol></>}
<h2>故事與出版</h2><Bookshelf/>
<h2>繼續探索</h2><p><a href={url('articles/')}>閱讀文章 →</a> · <a href={url('podcast/')}>收聽凡思聲 →</a></p>
{site.socialLinks.map(x=><p><a href={x.url}>{x.label}</a></p>)}<p><a href={url('contact/')}>來信與合作 →</a></p>
</section></Main>
<style>
.author-opening{display:grid;grid-template-columns:minmax(180px,280px) minmax(0,1fr);gap:64px;align-items:center;text-align:left}
.author-opening img{display:block;width:100%;height:auto;box-shadow:5px 7px 13px #373a391c}
.author-opening p{line-height:2;max-width:640px}.author-label{color:var(--muted)}
.author-journey ol{padding-left:24px;line-height:2}.author-journey>h2:not(:first-child){margin-top:48px}
@media(max-width:760px){.author-opening{grid-template-columns:1fr;gap:28px}.author-opening img{max-width:240px;margin:auto}}
</style>
