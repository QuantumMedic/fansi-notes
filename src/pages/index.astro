---
import Main from '../layouts/Main.astro';
import Storybook from '../components/Storybook.astro';
import WorkCard from '../components/WorkCard.astro';
import {getCollection} from 'astro:content';
import {url,topics} from '../data/site';
const articles=await getCollection('articles');
---
<Main><Storybook/>
<section class="section" id="latest"><div class="section-heading"><div><p class="eyebrow">翻開新的一頁</p><h2>最近的文字</h2></div><a class="muted" href={url('articles/')}>探索全部文章 ↗</a></div><p class="muted">以下為虛構測試資料，並非已發表作品。</p><div class="cards">{articles.map(a=><WorkCard id={a.id} {...a.data} type={a.data.content_type}/>)}</div></section>
<section class="section topic-section"><p class="eyebrow">順著一個念頭</p><h2>今天，你對什麼好奇？</h2><div class="topic-links">{topics.map(t=><a href={url(`topics/${t.slug}/`)}>{t.name} ↗</a>)}</div><p class="muted">主題索引示意；正式標籤待作者確認。</p></section>
<section class="section"><div class="section-heading"><h2>值得停留的篇章</h2><span>作者精選 · 待確認</span></div><p>這裡將收錄作者指定的代表作品。</p></section>
<section class="podcast-strip"><div class="podcast-art" aria-hidden="true"><span>凡思聲</span><div class="wave">│┃│┃│┃│┃│┃│┃│┃│</div><small>封面示意</small></div><div><p class="eyebrow">聲音的房間</p><h2>換一種方式，<br/>走進文字。</h2><p>節目介紹與最新單集待提供。<br/>先留一個位置，給下一次聆聽。</p><a class="text-link" href={url('podcast/')}>走進凡思聲 ↗</a></div></section>
<section class="section"><div class="section-heading"><h2>書架上的世界</h2><a class="muted" href={url('works/')}>小說與出版 ↗</a></div><div class="shelf-preview"><div class="blank-books" aria-hidden="true"><span>書封待提供</span><span>作品示意</span><span>尚未定版</span></div><p>真實書封與出版資料，<br/>將在作者核准後與你見面。</p></div></section>
<section class="section author-note"><p class="eyebrow">書頁背後</p><h2>關於寫下這些文字的人</h2><p>作者公開署名與簡介待確認。</p><a class="text-link" href={url('about/')}>走近作者的書桌 ↗</a><a class="text-link" href={url('contact/')}>來信與合作 ↗</a></section>
</Main>
<style>.topic-section{text-align:center;background:#e9e7da;max-width:none;padding:45px 24px}.topic-section .topic-links{justify-content:center}.topic-section h2{margin:12px 0}.podcast-strip{max-width:1116px;margin:0 auto 40px;padding:45px 7%;display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;background:#e4e4d5}.podcast-strip h2{font-size:2.7rem;margin:12px 0}.podcast-strip p{font-size:14px;color:var(--muted)}.podcast-art{aspect-ratio:1;background:#788b7b;color:#fffaf0;padding:35px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;box-shadow:10px 12px 0 #cbd1bf}.podcast-art>span{font:28px var(--serif);letter-spacing:.3em}.podcast-art small{font-size:11px}.wave{font-size:26px;letter-spacing:5px;transform:scaleY(1.8);white-space:nowrap}.text-link{display:inline-block;border-bottom:1px solid var(--bronze);padding:8px 0;margin:10px 24px 10px 0}.shelf-preview{display:flex;gap:70px;align-items:center;padding:25px 0 0}.blank-books{display:flex;gap:20px;align-items:end;border-bottom:8px solid #bdac8c;padding:0 20px 5px;flex:1}.blank-books span{display:block;writing-mode:vertical-rl;padding:30px 23px;height:170px;background:#c4cbb9;font:15px var(--serif);letter-spacing:.25em;border-left:7px solid #aab39f}.blank-books span:nth-child(2){background:#d7c4a9;height:195px;border-color:#bdab91}.blank-books span:nth-child(3){background:#c7c5b5;height:150px;border-color:#aeac97}.shelf-preview p{color:var(--muted);font-size:14px}.author-note{text-align:center;padding-top:10px;padding-bottom:85px}.author-note p:not(.eyebrow){color:var(--muted)}@media(max-width:760px){.podcast-strip{margin:0 24px 20px;padding:28px;grid-template-columns:1fr;gap:28px}.podcast-art{max-width:260px;width:100%;margin:auto}.podcast-strip h2{font-size:2.3rem}.shelf-preview{display:block}.blank-books{gap:12px;padding-left:5px;padding-right:5px}.blank-books span{padding:25px 18px}.shelf-preview p{padding:10px}.author-note h2{font-size:1.7rem}.wave{font-size:22px;letter-spacing:2px}}</style>
