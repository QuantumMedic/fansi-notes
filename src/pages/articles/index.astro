---
import Main from '../../layouts/Main.astro';
import WorkCard from '../../components/WorkCard.astro';
import {getCollection} from 'astro:content';
const articles=await getCollection('articles');
---
<Main title="探索文章"><section class="page-heading"><p class="eyebrow">文字的入口</p><h1>探索文章</h1><p>在這裡，找一個想繼續想下去的問題。</p><p class="muted">目前僅提供虛構測試資料；完整內容搜尋於 M3 擴充。</p></section><section class="section" id="search"><form class="filters" role="search"><label>搜尋測試標題或摘要<input type="search" name="q" id="query" placeholder="輸入關鍵字"/></label><label>內容類型<select id="type" name="type"><option value="">全部文章</option><option value="fansiwei">凡思維</option><option value="longform">深度文章</option></select></label><button type="reset">清除篩選</button></form><p id="results" role="status">共 {articles.length} 篇測試文章</p><div class="cards">{articles.map(a=><div data-result data-type={a.data.content_type} data-search={`${a.data.title} ${a.data.summary}`}><WorkCard id={a.id} {...a.data} type={a.data.content_type}/></div>)}</div><p id="no-results" hidden>沒有符合的文章，請清除篩選再試一次。</p></section></Main>
<script>
const form=document.querySelector('form')!;const query=document.querySelector<HTMLInputElement>('#query')!;const type=document.querySelector<HTMLSelectElement>('#type')!;
const params=new URLSearchParams(location.search);type.value=params.get('type')||'';query.value=params.get('q')||'';
function filter(){let count=0;document.querySelectorAll<HTMLElement>('[data-result]').forEach(el=>{el.hidden=!(el.dataset.search!.includes(query.value.trim())&&(!type.value||el.dataset.type===type.value));if(!el.hidden)count++});document.querySelector('#results')!.textContent=`共 ${count} 篇測試文章`;document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;}
form.addEventListener('submit',e=>{e.preventDefault();filter()});form.addEventListener('input',filter);form.addEventListener('reset',()=>setTimeout(filter));filter();
</script>
