---
import Main from '../../layouts/Main.astro';
import WorkCard from '../../components/WorkCard.astro';
import {getCollection} from 'astro:content';
import {topics} from '../../data/site';
const articles=await getCollection('articles');
---
<Main title="探索文章"><section class="page-heading"><p class="eyebrow">文字的入口</p><h1>探索文章</h1><p>在這裡，找一個想繼續想下去的問題。</p><p class="muted">目前僅提供虛構測試資料，可搜尋標題、摘要與完整正文。</p></section><section class="section" id="search"><form class="filters" role="search"><label>搜尋標題、摘要或正文<input type="search" name="q" id="query" placeholder="輸入關鍵字"/></label><label>內容類型<select id="type" name="type"><option value="">全部文章</option><option value="fansiwei">凡思維</option><option value="longform">深度文章</option></select></label><label>主題<select id="topic"><option value="">全部主題</option>{topics.map(t=><option value={t.slug}>{t.name}</option>)}</select></label><button type="reset">清除篩選</button></form><p id="results" role="status">共 {articles.length} 篇測試文章</p><div class="cards">{articles.map(a=><div data-result data-type={a.data.content_type} data-topics={a.data.topics.join(" ")} data-search={`${a.data.title} ${a.data.summary} ${a.body || ""}`}><WorkCard id={a.id} {...a.data} type={a.data.content_type}/></div>)}</div><p id="no-results" hidden>沒有符合的文章，請清除篩選再試一次。</p></section></Main>
<script>
const form=document.querySelector('form')!;const query=document.querySelector<HTMLInputElement>('#query')!;const type=document.querySelector<HTMLSelectElement>('#type')!;
const topic=document.querySelector<HTMLSelectElement>('#topic')!;
const params=new URLSearchParams(location.search);type.value=params.get('type')||'';query.value=params.get('q')||'';topic.value=params.get('topic')||'';
function filter(){let count=0;document.querySelectorAll<HTMLElement>('[data-result]').forEach(el=>{el.hidden=!(query.value.trim().toLocaleLowerCase().split(/\s+/).every(term=>el.dataset.search!.toLocaleLowerCase().includes(term))&&(!type.value||el.dataset.type===type.value)&&(!topic.value||el.dataset.topics!.split(' ').includes(topic.value)));if(!el.hidden)count++});document.querySelector('#results')!.textContent=`共 ${count} 篇測試文章`;document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;}
form.addEventListener('submit',e=>{e.preventDefault();filter()});form.addEventListener('input',filter);form.addEventListener('reset',()=>setTimeout(filter));filter();
</script>
