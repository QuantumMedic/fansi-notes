---
import Main from '../../layouts/Main.astro';
import WorkCard from '../../components/WorkCard.astro';
import { catalog } from '../../lib/catalog';
import { topics, series } from '../../data/site';
const articles = (await catalog()).articles;
---

<Main title="探索文章">
  <section class="page-heading">
    <p class="eyebrow">文字的入口</p>
    <h1>探索文章</h1>
    <p>在這裡，找一個想繼續想下去的問題。</p>
    <p class="muted">目前僅提供虛構測試資料，可搜尋標題、摘要與完整正文。</p>
  </section>
  <section class="section" id="search">
    <form class="filters" role="search">
      <label>
        搜尋標題、摘要或正文
        <input type="search" name="q" id="query" placeholder="輸入關鍵字" />
      </label>
      <label>
        作品系列
        <select id="type" name="type">
          <option value="">全部文章</option>
          {series.map((s) => (
            <option value={s.slug}>{s.name}</option>
          ))}
        </select>
      </label>
      <label>
        主題
        <select id="topic">
          <option value="">全部主題</option>
          {topics.map((t) => (
            <option value={t.slug}>{t.name}</option>
          ))}
        </select>
      </label>
      <label>
        排序
        <select id="sort">
          <option value="newest">最新優先</option>
          <option value="oldest">最早優先</option>
        </select>
      </label>
      <button type="reset">清除篩選</button>
    </form>
    <p id="results" role="status">
      共 {articles.length} 篇測試文章
    </p>
    <div class="cards" id="article-results">
      {articles.map((a) => (
        <div
          data-result
          data-date={a.data.published_at}
          data-type={a.data.content_type}
          data-topics={a.data.topics.join(' ')}
          data-search={`${a.data.title} ${a.data.summary} ${a.body || ''} ${a.data.keywords.join(' ')}`}
        >
          <WorkCard id={a.data.slug} {...a.data} type={a.data.content_type} />
        </div>
      ))}
    </div>
    <p id="no-results" hidden>
      沒有符合的文章，請清除篩選再試一次。
    </p>
  </section>
</Main>
<script>
  import { matchesSearch } from '../../lib/search.mjs';
  const form = document.querySelector('form')!;
  const query = document.querySelector<HTMLInputElement>('#query')!;
  const type = document.querySelector<HTMLSelectElement>('#type')!;
  const topic = document.querySelector<HTMLSelectElement>('#topic')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const params = new URLSearchParams(location.search);
  type.value = params.get('type') || '';
  query.value = params.get('q') || '';
  topic.value = params.get('topic') || '';
  function filter() {
    const list = document.querySelector('#article-results')!;
    [...document.querySelectorAll<HTMLElement>('[data-result]')]
      .sort(
        (a, b) =>
          (Date.parse(b.dataset.date!) - Date.parse(a.dataset.date!)) *
          (sort.value === 'oldest' ? -1 : 1),
      )
      .forEach((el) => list.append(el));
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-result]').forEach((el) => {
      el.hidden = !matchesSearch(
        el.dataset.search!,
        el.dataset.topics!.split(' '),
        el.dataset.type!,
        { q: query.value, topic: topic.value, contentType: type.value },
      );
      if (!el.hidden) count++;
    });
    document.querySelector('#results')!.textContent = `共 ${count} 篇測試文章`;
    document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
  }
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    filter();
  });
  form.addEventListener('input', filter);
  form.addEventListener('reset', () => setTimeout(filter));
  filter();
</script>
