---
import { showArticleSummary } from '../../lib/article-presentation.mjs';
import { seriesName } from '../../lib/taxonomy.mjs';
import Main from '../../layouts/Main.astro';
import PublicationRelations from '../../components/PublicationRelations.astro';
import ServiceState from '../../components/ServiceState.astro';
import { render } from 'astro:content';
import { catalog, displayDate } from '../../lib/catalog';
import { relatedArticles } from '../../lib/model.mjs';
import ArticlePlatforms from '../../components/ArticlePlatforms.astro';
import { importedListeningPresentation, listeningDestination } from '../../lib/listening-presentation.mjs';
import { url, topics } from '../../data/site';
export async function getStaticPaths() {
  return (await catalog()).articles.flatMap((article) =>
    [article.data.slug, ...article.data.aliases].map((slug) => ({
      params: { slug },
      props: { article },
    })),
  );
}
const { article } = Astro.props;
if (Astro.params.slug !== article.data.slug)
  return Astro.redirect(url(`articles/${article.data.slug}/`), 301);
const all = await catalog();
const episodes = all.episodes.filter((e) =>
  all.mapping.some((m) => m.guid === e.guid && m.work_id === article.data.work_id),
);
const { Content, headings } = await render(article);
const presentation = importedListeningPresentation(article.body, episodes);
const sourceLinks = presentation.links.map(link => ({ ...link,
  title: all.episodes.find(e => [e.spotify_episode_url, e.apple_episode_url]
    .some(href => href && listeningDestination(href)?.key === link.key))?.title,
}));
const longform = article.data.content_type === 'longform';
const related = relatedArticles(
  article.data,
  all.articles.map((a) => a.data),
);
const minutes = Math.max(1, Math.ceil((article.body || '').replace(/<[^>]*>/g, '').length / 400));
---

<Main title={article.data.title} description={article.data.summary}>
  <header class:list={['article-header', { immersive: longform }]}>
    <div class="article-title">
      <a href={url('articles/')}>← 探索文章</a>
      <p class="eyebrow">
        {seriesName(article.data.content_type)} ·{' '}
        {article.data.synthetic ? '虛構測試資料' : article.data.public_author_name}
      </p>
      <h1>{article.data.title}</h1>
      {showArticleSummary(article.data.summary, article.body, article.data.summary_kind) && <p class="lede">{article.data.summary}</p>}
      <p class="muted">
        閱讀約 {minutes} 分鐘 · {article.data.synthetic ? '示意日期' : '發布日期'}{' '}
        {displayDate(article.data.published_at)}
      </p>
      <p class="muted">
        {article.data.subtitle}
        {article.data.updated_at && ` · 更新：${displayDate(article.data.updated_at)}`}
      </p>
      <nav aria-label="文章主題" class="topic-links">
        {article.data.topics.map((t) => (
          <a href={url(`topics/${t}/`)}>{topics.find((x) => x.slug === t)?.name}</a>
        ))}
      </nav>
    </div>
    {article.data.cover_image ? (
      <img class="real-cover" src={url(article.data.cover_image)} alt={article.data.cover_alt} />
    ) : (
      longform && article.data.synthetic && (
        <div class="article-illustration" aria-hidden="true">
          <div class="arch"></div>
          <span>封面插畫示意</span>
        </div>
      )
    )}
  </header>
  <article class="reading article-body">
    {longform && headings.length > 0 && (
      <nav aria-label="文章目錄" class="contents">
        <p class="eyebrow">本篇目錄</p>
        {headings.map((h) => (
          <a href={`#${h.slug}`}>{h.text}</a>
        ))}
      </nav>
    )}
    {presentation.html === null ? <Content /> : <Fragment set:html={presentation.html} />}
    {article.data.sources.length > 0 && (
      <section class="empty">
        <h2>研究與參考資料</h2>
        {article.data.sources.map((source) => (
          <p>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
          </p>
        ))}
      </section>
    )}
    <ArticlePlatforms platforms={article.data.platform_urls} episodes={episodes} sourceLinks={sourceLinks} />
    <section class="empty">
      <h2>繼續閱讀</h2>
      {related.length ? (
        related.map((a) => (
          <p>
            <a href={url(`articles/${a.slug}/`)}>{a.title} ↗</a>
          </p>
        ))
      ) : (
        <p class="muted">尚無相同主題的其他作品。</p>
      )}
    </section>
    <PublicationRelations workId={article.data.work_id} kind="article" />
    <ServiceState kind="comments" />
  </article>
</Main>
<style>
  .real-cover {
    width: 100%;
    height: auto;
    max-height: 450px;
    object-fit: cover;
  }
  .article-header {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 32px 20px;
  }
  .article-title {
    max-width: 720px;
    margin: auto;
  }
  .article-title h1 {
    font-size: clamp(2.5rem, 5vw, 4.4rem);
  }
  .immersive {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 65px;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 70px;
  }
  .article-illustration {
    height: 380px;
    background: #bec6b5;
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .arch {
    width: 160px;
    height: 250px;
    border: 18px solid #939e87;
    border-bottom: 0;
    border-radius: 90px 90px 0 0;
    background: #ece3cf;
    box-shadow: 26px 16px 0 #a8b19b;
    transform: translateY(40px);
  }
  .article-illustration span {
    position: absolute;
    bottom: 12px;
    left: 18px;
    font-size: 11px;
  }
  .article-body {
    padding-top: 30px;
  }
  .contents {
    padding: 20px 24px;
    background: #eae5d9;
    margin-bottom: 40px;
  }
  .contents a {
    display: block;
    padding: 6px 0;
  }
  .article-body :global(h2) {
    scroll-margin-top: 25px;
  }
  .article-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .article-body :global(blockquote) {
    border-left: 3px solid var(--bronze);
    padding-left: 25px;
    margin: 30px 0;
  }
  .article-body :global(img) {
    max-width: 100%;
    height: auto;
  }
  .article-body :global(pre) {
    overflow-x: auto;
  }
  @media (max-width: 760px) {
    .article-header {
      padding: 40px 24px 10px;
    }
    .immersive {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .article-illustration {
      height: 240px;
    }
    .arch {
      height: 200px;
      width: 130px;
    }
    .article-title h1 {
      font-size: 2.6rem;
    }
  }
</style>

<style>
.article-body :global(.imported-original){overflow-wrap:anywhere}.article-body :global(.imported-original h3){font-size:1.45rem;line-height:1.65;margin:2.3em 0 1em}.article-body :global(.imported-original p:empty),.article-body :global(.imported-original h2:empty){display:none}.article-body :global(.source-image-placeholder){margin:0;padding:0;border:0}.article-body :global(.source-image-placeholder:not(:has(figcaption:not([hidden])))){display:none}.article-body :global(.image-position){display:none}.article-body :global(figcaption){font-size:13px;margin:1em 0;color:var(--muted)}.article-header.immersive:has(.article-title:only-child){display:block}.article-header.immersive:has(.article-title:only-child) .article-title{max-width:760px}
</style>
